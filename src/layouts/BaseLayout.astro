---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PantoneThemeScript from '../components/PantoneThemeScript.astro';
import '../styles/tactical.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "ISKANDER // Strategic Geopolitics & Military Creator Command Portal",
  description = "The all-in-one tactical dashboard for geopolitics, naval warfare, advanced weapons and space technology content creators. Deployed on Cloudflare Pages.",
  image = "/og-image.svg"
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F5DF4D" />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://iskander.dbdd.in/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter / X -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://iskander.dbdd.in/" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Pre-render theme check to prevent flash -->
    <script is:inline>
      try {
        const theme = localStorage.getItem('iskander_pantone_theme');
        if (theme && theme !== 'pentad') {
          document.documentElement.setAttribute('data-pantone-theme', theme);
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <PantoneThemeScript />


  </body>
</html>
