---
// ArmsTradeVisualizer.astro - Feature 12: SIPRI Defense Budgets & Arms Trade Visualizer
---
<div class="hud-panel hud-corner arms-trade-card">
  <div class="at-header">
    <div>
      <div class="at-title-row">
        <span class="badge badge-pantone-2025">SIPRI DEFENSE INTELLIGENCE</span>
        <h3 class="font-mono at-heading">GLOBAL DEFENSE EXPENDITURE & ARMS TRANSFERS</h3>
      </div>
      <p class="font-mono text-muted" style="font-size: 0.76rem;">Defense spending as % of GDP, procurement backlogs & top global arms transfer corridors.</p>
    </div>

    <div class="total-spend-pill font-mono">
      <span class="pill-k">TOTAL GLOBAL MILITARY EXPENDITURE:</span>
      <span class="pill-v" style="color: var(--primary); font-weight: 800;">$2.44 Trillion USD</span>
    </div>
  </div>

  <div class="at-grid">
    <!-- Top Spenders Bar Graph -->
    <div class="spenders-column hud-panel font-mono">
      <div class="col-head">
        <span class="badge badge-pantone-2021">TOP DEFENSE BUDGETS</span>
        <div class="sort-controls">
          <button class="sort-btn active" id="sortSpend" data-sort="spend">BY SPEND</button>
          <button class="sort-btn" id="sortGdp" data-sort="gdp">BY % GDP</button>
        </div>
      </div>

      <div class="spend-bars-list" id="spendBarsList"></div>
    </div>

    <!-- Top Arms Exporters vs Importers Corridors -->
    <div class="corridors-column hud-panel font-mono">
      <div class="col-head">
        <span class="badge badge-pantone-2024">ARMS TRANSFER FLOWS</span>
        <span style="font-size: 0.72rem; color: var(--text-dim);">MAJOR BILATERAL CORRIDORS</span>
      </div>

      <div class="corridors-list">
        <div class="corridor-card">
          <div class="corr-top">
            <span class="corr-title" style="color: #F5DF4D;">US → Middle East & Indo-Pacific</span>
            <span class="corr-share">42% of Global Exports</span>
          </div>
          <p class="corr-desc">F-35A/B/C Lightning II fighters, Patriot PAC-3 MSE, Aegis SPY-6, AH-64E Apache attack helicopters.</p>
        </div>

        <div class="corridor-card">
          <div class="corr-top">
            <span class="corr-title" style="color: #FFBE98;">France → India / UAE / Greece</span>
            <span class="corr-share">11% of Global Exports</span>
          </div>
          <p class="corr-desc">Dassault Rafale F3R/F4 omnirole fighters, Scorpène-class submarines, Aster 30 naval surface-to-air missiles.</p>
        </div>

        <div class="corridor-card">
          <div class="corr-top">
            <span class="corr-title" style="color: #6667AB;">South Korea (K-Defense) → Poland / SEA</span>
            <span class="corr-share">Fastest Growing Exporter</span>
          </div>
          <p class="corr-desc">K2 Black Panther tanks, K9 Thunder 155mm howitzers, FA-50 light combat aircraft delivered in record 102 days.</p>
        </div>

        <div class="creator-arms-hook">
          <span class="hook-tag-arms">CREATOR VIDEO HOOK (THE REAL ARMS RACE):</span>
          <p class="hook-text-arms">
            "While everyone focuses on fighter jet dogfights, the real geopolitical shift is defense industrial throughput. South Korea delivered 10 K2 tanks to Poland before European suppliers could even draft the procurement contract."
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  const countries = [
    { name: 'United States',    spend: 916, gdp: 3.4, color: '#F5DF4D' },
    { name: 'China (Estimated)', spend: 296, gdp: 1.7, color: '#BB2649' },
    { name: 'Russia',           spend: 109, gdp: 5.9, color: '#FFBE98' },
    { name: 'India',            spend: 83.6, gdp: 2.4, color: '#6667AB' },
    { name: 'Saudi Arabia',     spend: 75.8, gdp: 7.1, color: '#A47864' },
    { name: 'United Kingdom',   spend: 74.9, gdp: 2.3, color: '#939597' }
  ];

  function renderBars(sortBy) {
    const list = document.getElementById('spendBarsList');
    if (!list) return;

    const sorted = [...countries].sort((a, b) => sortBy === 'gdp' ? b.gdp - a.gdp : b.spend - a.spend);
    const maxVal = sortBy === 'gdp' ? Math.max(...sorted.map(c => c.gdp)) : sorted[0].spend;

    list.innerHTML = sorted.map(c => {
      const pct = sortBy === 'gdp'
        ? ((c.gdp / maxVal) * 100).toFixed(0)
        : ((c.spend / maxVal) * 100).toFixed(0);
      const label = sortBy === 'gdp'
        ? `${c.gdp}% GDP ($${c.spend}B)`
        : `$${c.spend} Billion (${c.gdp}% GDP)`;
      return `<div class="spend-row">
        <div class="spend-meta">
          <span class="country">${c.name}</span>
          <span class="val" style="color: ${c.color};">${label}</span>
        </div>
        <div class="bar-shell">
          <div class="bar-fill" style="width: ${pct}%; background: ${c.color}; transition: width 0.5s ease;"></div>
        </div>
      </div>`;
    }).join('');
  }

  document.querySelectorAll('.sort-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.sort-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      renderBars(btn.getAttribute('data-sort'));
    });
  });

  renderBars('spend');
</script>

<style>
  .arms-trade-card {
    padding: 1.5rem;
    margin-bottom: 2rem;
  }

  .at-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(147, 149, 151, 0.15);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .at-title-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.25rem;
  }

  .at-heading {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--text-main);
  }

  .total-spend-pill {
    font-size: 0.74rem;
    background: rgba(8, 11, 15, 0.7);
    padding: 0.35rem 0.75rem;
    border-radius: 3px;
    border: 1px solid var(--border-color);
  }
  .pill-k {
    color: var(--text-dim);
  }

  .at-grid {
    display: grid;
    grid-template-columns: 1.1fr 1.3fr;
    gap: 1.5rem;
  }

  .spenders-column,
  .corridors-column {
    background: rgba(14, 19, 26, 0.95);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .col-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(147, 149, 151, 0.15);
  }

  .spend-bars-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .spend-row {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .spend-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.72rem;
  }

  .bar-shell {
    height: 8px;
    background: rgba(8, 11, 15, 0.8);
    border-radius: 3px;
    overflow: hidden;
    border: 1px solid rgba(147, 149, 151, 0.2);
  }

  .bar-fill {
    height: 100%;
    border-radius: 2px;
  }

  .corridors-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .corridor-card {
    background: var(--bg-card);
    padding: 0.75rem;
    border-radius: 3px;
    border: 1px solid rgba(147, 149, 151, 0.12);
  }

  .corr-top {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    font-weight: 800;
    margin-bottom: 0.25rem;
  }

  .corr-share {
    color: var(--text-dim);
  }

  .corr-desc {
    font-size: 0.72rem;
    color: var(--text-muted);
    font-family: sans-serif;
  }

  .creator-arms-hook {
    background: rgba(245, 223, 77, 0.08);
    border-left: 2px solid var(--primary);
    padding: 0.75rem;
    border-radius: 2px;
  }

  .hook-tag-arms {
    font-size: 0.65rem;
    color: var(--primary);
    font-weight: 800;
    display: block;
    margin-bottom: 0.25rem;
  }

  .hook-text-arms {
    font-size: 0.76rem;
    color: var(--text-main);
    line-height: 1.4;
    font-style: italic;
  }

  @media (max-width: 900px) {
    .at-grid {
      grid-template-columns: 1fr;
    }
  }

  .sort-controls {
    display: flex;
    gap: 0.35rem;
  }
  .sort-btn {
    font-family: "SF Mono", Monaco, monospace;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 2px;
    border: 1px solid var(--border-color);
    background: transparent;
    color: var(--text-dim);
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .sort-btn:hover { color: var(--text-main); }
  .sort-btn.active {
    background: rgba(245, 223, 77, 0.15);
    border-color: var(--primary);
    color: var(--primary);
  }
</style>
