---
// IntelTicker.astro - Feature 11: OSINT Breaking News & Intel Wire
---
<div class="intel-ticker-wrapper">
  <div class="container">
    <div class="ticker-box hud-panel">
      <div class="ticker-label font-mono">
        <span class="live-blip"></span>
        <span>OSINT INTEL WIRE</span>
      </div>
      
      <div class="ticker-marquee-track">
        <div class="ticker-marquee-content font-mono" id="tickerItems">
          <span class="ticker-item"><strong style="color: #BB2649;">[FLASH RED SEA]</strong> CSG-2 intercepts 3 anti-ship ballistic missiles in southern Bab el-Mandeb; commercial tanker traffic diversion rate reaches 71.4%.</span>
          <span class="ticker-item"><strong style="color: #F5DF4D;">[TAIWAN STRAIT]</strong> PLAN Carrier Shandong initiates combat air patrol 180nm east of Hualien; 28 sorties tracked by ROCAF CAP.</span>
          <span class="ticker-item"><strong style="color: #6667AB;">[SPACE TRACK]</strong> NRO reconnaissance satellite USA-314 completes high-inclination orbital pass over Barents Sea submarine bastions.</span>
          <span class="ticker-item"><strong style="color: #FFBE98;">[STRAIT OF HORMUZ]</strong> IRGCN fast-attack craft conduct swarm drills adjacent to Tunb Islands transit lanes; crude freight risk premium +18bps.</span>
          <span class="ticker-item"><strong style="color: #A47864;">[SUWALKI GAP]</strong> NATO Enhanced Forward Presence battlegroups conclude Iron Spear heavy armor interoperability exercise.</span>
        </div>
      </div>

      <div class="ticker-controls font-mono">
        <button id="tickerPauseBtn" class="ticker-ctrl-btn" title="Pause / Resume Ticker">⏸</button>
        <span class="update-clock" id="utcClock">UTC 00:00:00</span>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  // Live UTC Clock updater
  function updateClock() {
    const now = new Date();
    const utc = now.toUTCString().split(' ')[4] + ' UTC';
    const el = document.getElementById('utcClock');
    if (el) el.innerText = utc;
  }
  setInterval(updateClock, 1000);
  updateClock();

  // Marquee pause toggle
  const pauseBtn = document.getElementById('tickerPauseBtn');
  const track = document.querySelector('.ticker-marquee-content');
  if (pauseBtn && track) {
    let paused = false;
    pauseBtn.addEventListener('click', () => {
      paused = !paused;
      track.style.animationPlayState = paused ? 'paused' : 'running';
      pauseBtn.innerText = paused ? '▶' : '⏸';
    });
  }
</script>

<style>
  .intel-ticker-wrapper {
    background: #090C10;
    border-bottom: 1px solid var(--border-color);
    padding: 0.4rem 0;
  }

  .ticker-box {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.35rem 0.85rem;
    background: rgba(14, 19, 26, 0.95);
    border-radius: 3px;
    overflow: hidden;
  }

  .ticker-label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--primary);
    white-space: nowrap;
    border-right: 1px solid var(--border-color);
    padding-right: 0.85rem;
  }

  .live-blip {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #BB2649;
    animation: blip-anim 1s infinite alternate;
  }

  @keyframes blip-anim {
    from { transform: scale(0.8); opacity: 0.5; }
    to { transform: scale(1.3); opacity: 1; }
  }

  .ticker-marquee-track {
    flex: 1;
    overflow: hidden;
    position: relative;
    white-space: nowrap;
  }

  .ticker-marquee-content {
    display: inline-block;
    padding-left: 100%;
    animation: marquee-roll 45s linear infinite;
    font-size: 0.78rem;
    color: var(--text-main);
  }

  .ticker-item {
    margin-right: 3rem;
  }

  @keyframes marquee-roll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-100%); }
  }

  .ticker-controls {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    border-left: 1px solid var(--border-color);
    padding-left: 0.85rem;
    font-size: 0.72rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .ticker-ctrl-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    font-size: 0.75rem;
  }
  .ticker-ctrl-btn:hover {
    color: var(--primary);
  }

  .update-clock {
    color: var(--primary);
    font-weight: 700;
  }
</style>
