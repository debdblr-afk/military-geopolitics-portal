---
// Footer.astro
---
<footer class="site-footer">
  <div class="container">
    <!-- Top Row: Pantone Palette Legend -->
    <div class="palette-legend hud-panel">
      <div class="legend-header">
        <span class="hud-label font-mono">PANTONE COLOR OF THE YEAR CHROMATIC DEFENSE MATRIX (2021-2025)</span>
        <span class="legend-note font-mono">100% PURE PALETTE INTEGRATION</span>
      </div>
      <div class="pantone-swatch-grid">
        <div class="swatch-card" style="border-top: 3px solid #F5DF4D;">
          <span class="swatch-year font-mono">2021</span>
          <span class="swatch-name">Illuminating</span>
          <span class="swatch-hex font-mono">#F5DF4D</span>
          <span class="swatch-role">Target / Warning / Pulse</span>
        </div>
        <div class="swatch-card" style="border-top: 3px solid #939597;">
          <span class="swatch-year font-mono">2021</span>
          <span class="swatch-name">Ultimate Gray</span>
          <span class="swatch-hex font-mono">#939597</span>
          <span class="swatch-role">Armor Steel / Chassis</span>
        </div>
        <div class="swatch-card" style="border-top: 3px solid #6667AB;">
          <span class="swatch-year font-mono">2022</span>
          <span class="swatch-name">Very Peri</span>
          <span class="swatch-hex font-mono">#6667AB</span>
          <span class="swatch-role">Space Tech / EW / Sensors</span>
        </div>
        <div class="swatch-card" style="border-top: 3px solid #BB2649;">
          <span class="swatch-year font-mono">2023</span>
          <span class="swatch-name">Viva Magenta</span>
          <span class="swatch-hex font-mono">#BB2649</span>
          <span class="swatch-role">Kinetic Strike / Threat Ring</span>
        </div>
        <div class="swatch-card" style="border-top: 3px solid #FFBE98;">
          <span class="swatch-year font-mono">2024</span>
          <span class="swatch-name">Peach Fuzz</span>
          <span class="swatch-hex font-mono">#FFBE98</span>
          <span class="swatch-role">Diplomacy / Maritime Chokepoints</span>
        </div>
        <div class="swatch-card" style="border-top: 3px solid #A47864;">
          <span class="swatch-year font-mono">2025</span>
          <span class="swatch-name">Mocha Mousse</span>
          <span class="swatch-hex font-mono">#A47864</span>
          <span class="swatch-role">Land Armor / Fortifications</span>
        </div>
      </div>
    </div>

    <!-- Bottom Row: Meta & Links -->
    <div class="footer-meta">
      <div class="meta-left">
        <p class="font-mono"><strong>ISKANDER STRATEGIC DISPATCH</strong> // Advanced Geopolitics, Naval Warfare & Weapons Creator Portal</p>
        <p class="meta-sub font-mono">Configured for Cloudflare Pages edge delivery with sub-100ms global latency & Netlify CMS decoupled Git-backend.</p>
      </div>
      <div class="meta-right font-mono">
        <span class="tag">HOST: CLOUDFLARE PAGES</span>
        <span class="tag">TARGET DOMAIN: iskander.dbdd.in</span>
        <a href="/admin/" target="_blank" class="tag tag-cms">CMS ADMIN</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border-color);
    background: #06090D;
    padding: 3rem 0 2rem;
    margin-top: 4rem;
  }

  .palette-legend {
    padding: 1.5rem;
    margin-bottom: 2rem;
    background: rgba(14, 19, 26, 0.85);
  }

  .legend-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(147, 149, 151, 0.15);
  }

  .hud-label {
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--primary);
    letter-spacing: 0.05em;
  }

  .legend-note {
    font-size: 0.72rem;
    color: var(--text-dim);
  }

  .pantone-swatch-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
  }

  .swatch-card {
    background: var(--bg-card);
    padding: 0.9rem;
    border-radius: 3px;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .swatch-year {
    font-size: 0.7rem;
    color: var(--text-dim);
    font-weight: 700;
  }

  .swatch-name {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .swatch-hex {
    font-size: 0.76rem;
    color: var(--text-muted);
  }

  .swatch-role {
    font-size: 0.7rem;
    color: var(--primary);
    margin-top: 0.35rem;
    font-family: "SF Mono", Monaco, monospace;
  }

  .footer-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(147, 149, 151, 0.1);
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .meta-sub {
    font-size: 0.74rem;
    color: var(--text-dim);
    margin-top: 0.3rem;
  }

  .meta-right {
    display: flex;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .tag {
    background: rgba(147, 149, 151, 0.1);
    border: 1px solid rgba(147, 149, 151, 0.2);
    padding: 0.25rem 0.55rem;
    border-radius: 2px;
    font-size: 0.72rem;
  }

  .tag-cms {
    color: var(--primary);
    border-color: rgba(var(--primary-rgb), 0.4);
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .tag-cms:hover {
    background: rgba(var(--primary-rgb), 0.15);
  }
</style>
