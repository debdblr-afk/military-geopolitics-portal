      meta: "Second Island Chain forward operating hub • B-21 / B-52 bomber dispersal",
      threat: "DF-26 'Guam Express' IRBMs, Russian air-launched cruise missiles",
      val: "Forward logistics for Western Pacific projection",
      defcon: "HIGH READINESS (DEFCON 3)",
      bypass: "Hawaii / Darwin (Australia)",
      hook: "Why is the Pentagon spending $1.5 Billion installing a 360-degree Enhanced Integrated Air and Missile Defense (EIAMD) shield over a tiny island named Guam? Because whoever controls Guam controls the Second Island Chain."
    },
    bosphorus: {
      title: "Bosphorus & Turkish Straits",
      badge: "MARITIME CHOKEPOINT",
      meta: "0.7 km wide at narrowest • Montreux Convention controls warship transit",
