---
// StrategicMap.astro - Feature 1: Interactive Geopolitical & Naval Theater Map
---
<div class="hud-panel hud-corner map-container">
  <div class="map-header">
    <div class="map-title-group">
      <span class="radar-pulse"></span>
      <div>
        <h3 class="font-mono" style="color: var(--primary); font-size: 1.05rem;">THEATER SITUATION MAP // GLOBAL FLASHPOINTS & CHOKEPOINTS</h3>
        <p class="font-mono text-muted" style="font-size: 0.74rem;">Interactive Strategic Projection (Layers: Maritime Chokepoints, Kinetic Flashpoints, Strategic Bases)</p>
      </div>
    </div>
    
    <!-- Layer Toggles -->
    <div class="layer-toggles font-mono">
      <button class="layer-btn active" data-layer="chokepoints">
        <span class="swatch" style="background: var(--c-pantone-2024-peach);"></span>
        <span>Chokepoints (8)</span>
      </button>
      <button class="layer-btn active" data-layer="flashpoints">
        <span class="swatch" style="background: var(--c-pantone-2023-magenta);"></span>
        <span>Flashpoints (6)</span>
      </button>
      <button class="layer-btn active" data-layer="bases">
        <span class="swatch" style="background: var(--c-pantone-2022-peri);"></span>
        <span>Strategic Hubs (6)</span>
      </button>
    </div>
  </div>

  <div class="map-viewport-grid">
    <!-- SVG Map Canvas -->
    <div class="svg-map-wrapper">
      <svg viewBox="0 0 1000 520" class="strategic-svg" id="strategicMapSvg" preserveAspectRatio="xMidYMid meet">
        <defs>
          <radialGradient id="gridGlow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#F5DF4D" stop-opacity="0.08" />
            <stop offset="100%" stop-color="#080B0F" stop-opacity="0" />
          </radialGradient>
          <pattern id="tacticalGrid" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(147, 149, 151, 0.08)" stroke-width="0.8" />
            <circle cx="0" cy="0" r="1" fill="rgba(147, 149, 151, 0.2)" />
          </pattern>
        </defs>

        <!-- Background & Grid -->
        <rect width="1000" height="520" fill="#0A0E14" />
        <rect width="1000" height="520" fill="url(#tacticalGrid)" />
        <rect width="1000" height="520" fill="url(#gridGlow)" />

        <!-- Equator & Tropic Coordinates -->
        <line x1="0" y1="260" x2="1000" y2="260" stroke="rgba(147, 149, 151, 0.15)" stroke-dasharray="4 4" />
        <text x="960" y="255" fill="rgba(147, 149, 151, 0.4)" font-family="monospace" font-size="9">00° EQUATOR</text>
        <line x1="0" y1="160" x2="1000" y2="160" stroke="rgba(147, 149, 151, 0.1)" stroke-dasharray="2 4" />
        <text x="940" y="155" fill="rgba(147, 149, 151, 0.3)" font-family="monospace" font-size="8">23.5°N TROPIC</text>

        <!-- Continental Outlines (Stylized Low-poly Vector Continents) -->
        <!-- North America -->
        <path class="continent" d="M120,70 L240,60 L280,100 L260,150 L200,180 L180,240 L160,260 L140,230 L110,180 L80,130 Z" />
        <!-- South America -->
        <path class="continent" d="M260,280 L330,300 L350,370 L310,470 L270,470 L250,370 L240,310 Z" />
        <!-- Europe & Arctic -->
        <path class="continent" d="M470,80 L560,70 L580,130 L540,160 L480,150 L450,110 Z" />
        <!-- Africa -->
        <path class="continent" d="M470,180 L560,180 L590,260 L570,360 L520,440 L480,410 L450,290 L450,210 Z" />
        <!-- Asia / Eurasia -->
        <path class="continent" d="M570,80 L880,70 L910,140 L860,200 L760,240 L700,220 L660,170 L570,140 Z" />
        <!-- Australia & Oceania -->
        <path class="continent" d="M780,330 L880,320 L890,390 L850,440 L790,410 Z" />

        <!-- Undersea Fiber Cable Strategic Routes (Dotted Cyan/Peri line) -->
        <path d="M220,160 C 350,140 450,130 500,140" fill="none" stroke="rgba(102, 103, 171, 0.45)" stroke-width="1.2" stroke-dasharray="3 3" />
        <path d="M520,200 C 580,260 680,270 760,270" fill="none" stroke="rgba(102, 103, 171, 0.45)" stroke-width="1.2" stroke-dasharray="3 3" />
        <path d="M780,240 C 850,260 920,300 940,340" fill="none" stroke="rgba(102, 103, 171, 0.3)" stroke-width="1" stroke-dasharray="2 4" />

        <!-- CHOKEPOINTS LAYER (Peach Fuzz #FFBE98) -->
        <g id="layer-chokepoints">
          <!-- 1. Strait of Hormuz -->
          <g class="map-node" data-id="hormuz" transform="translate(605, 205)">
            <circle r="7" fill="none" stroke="#FFBE98" stroke-width="1.5" class="pulse-node" />
            <circle r="3.5" fill="#FFBE98" />
            <text x="10" y="4" fill="#FFBE98" font-family="monospace" font-size="9" font-weight="bold">STRAIT OF HORMUZ</text>
          </g>

          <!-- 2. Bab el-Mandeb -->
          <g class="map-node" data-id="mandeb" transform="translate(565, 240)">
            <circle r="7" fill="none" stroke="#FFBE98" stroke-width="1.5" class="pulse-node" />
            <circle r="3.5" fill="#FFBE98" />
            <text x="10" y="4" fill="#FFBE98" font-family="monospace" font-size="9" font-weight="bold">BAB EL-MANDEB</text>
          </g>

          <!-- 3. Malacca Strait -->
          <g class="map-node" data-id="malacca" transform="translate(745, 275)">
            <circle r="7" fill="none" stroke="#FFBE98" stroke-width="1.5" class="pulse-node" />
            <circle r="3.5" fill="#FFBE98" />
            <text x="10" y="4" fill="#FFBE98" font-family="monospace" font-size="9" font-weight="bold">MALACCA STRAIT</text>
          </g>

          <!-- 4. Taiwan Strait -->
          <g class="map-node" data-id="taiwan" transform="translate(815, 205)">
            <circle r="7" fill="none" stroke="#FFBE98" stroke-width="1.5" class="pulse-node" />
            <circle r="3.5" fill="#FFBE98" />
            <text x="10" y="4" fill="#FFBE98" font-family="monospace" font-size="9" font-weight="bold">TAIWAN STRAIT</text>
          </g>

          <!-- 5. GIUK Gap -->
          <g class="map-node" data-id="giuk" transform="translate(450, 95)">
            <circle r="7" fill="none" stroke="#FFBE98" stroke-width="1.5" class="pulse-node" />
            <circle r="3.5" fill="#FFBE98" />
            <text x="10" y="4" fill="#FFBE98" font-family="monospace" font-size="9" font-weight="bold">GIUK GAP</text>
          </g>

          <!-- 6. Bosphorus / Turkish Straits -->
          <g class="map-node" data-id="bosphorus" transform="translate(545, 145)">
            <circle r="6" fill="none" stroke="#FFBE98" stroke-width="1.5" class="pulse-node" />
            <circle r="3" fill="#FFBE98" />
            <text x="10" y="4" fill="#FFBE98" font-family="monospace" font-size="9" font-weight="bold">BOSPHORUS</text>
          </g>

          <!-- 7. Suez Canal -->
          <g class="map-node" data-id="suez" transform="translate(540, 185)">
            <circle r="6" fill="none" stroke="#FFBE98" stroke-width="1.5" class="pulse-node" />
            <circle r="3" fill="#FFBE98" />
            <text x="10" y="4" fill="#FFBE98" font-family="monospace" font-size="9" font-weight="bold">SUEZ CANAL</text>
          </g>

          <!-- 8. Panama Canal -->
          <g class="map-node" data-id="panama" transform="translate(235, 275)">
            <circle r="6" fill="none" stroke="#FFBE98" stroke-width="1.5" class="pulse-node" />
            <circle r="3" fill="#FFBE98" />
            <text x="10" y="4" fill="#FFBE98" font-family="monospace" font-size="9" font-weight="bold">PANAMA CANAL</text>
          </g>
        </g>

        <!-- FLASHPOINTS LAYER (Viva Magenta #BB2649) -->
        <g id="layer-flashpoints">
          <!-- 1. South China Sea -->
          <g class="map-node" data-id="scs" transform="translate(775, 235)">
            <polygon points="0,-8 7,5 -7,5" fill="#BB2649" class="pulse-danger" />
            <text x="12" y="4" fill="#FF6685" font-family="monospace" font-size="9" font-weight="bold">SOUTH CHINA SEA</text>
          </g>

          <!-- 2. Black Sea / Crimea -->
          <g class="map-node" data-id="blacksea" transform="translate(565, 130)">
            <polygon points="0,-8 7,5 -7,5" fill="#BB2649" class="pulse-danger" />
            <text x="12" y="4" fill="#FF6685" font-family="monospace" font-size="9" font-weight="bold">BLACK SEA THEATER</text>
          </g>

          <!-- 3. Red Sea & Gulf of Aden -->
          <g class="map-node" data-id="redsea" transform="translate(575, 225)">
            <polygon points="0,-8 7,5 -7,5" fill="#BB2649" class="pulse-danger" />
            <text x="12" y="4" fill="#FF6685" font-family="monospace" font-size="9" font-weight="bold">RED SEA / BAB THEATER</text>
          </g>

          <!-- 4. Suwalki Gap -->
          <g class="map-node" data-id="suwalki" transform="translate(520, 115)">
            <polygon points="0,-8 7,5 -7,5" fill="#BB2649" class="pulse-danger" />
            <text x="12" y="4" fill="#FF6685" font-family="monospace" font-size="9" font-weight="bold">SUWALKI CORRIDOR</text>
          </g>

          <!-- 5. Arctic Bastion / Kola Peninsula -->
          <g class="map-node" data-id="arctic" transform="translate(550, 60)">
            <polygon points="0,-8 7,5 -7,5" fill="#BB2649" class="pulse-danger" />
            <text x="12" y="4" fill="#FF6685" font-family="monospace" font-size="9" font-weight="bold">ARCTIC BASTION</text>
          </g>

          <!-- 6. Persian Gulf / Kharg Island -->
          <g class="map-node" data-id="persian_gulf" transform="translate(615, 185)">
            <polygon points="0,-8 7,5 -7,5" fill="#BB2649" class="pulse-danger" />
            <text x="12" y="4" fill="#FF6685" font-family="monospace" font-size="9" font-weight="bold">PERSIAN GULF</text>
          </g>
        </g>

        <!-- STRATEGIC HUBS / BASES (Very Peri #6667AB) -->
        <g id="layer-bases">
          <!-- Guam / Andersen AFB -->
          <g class="map-node" data-id="guam" transform="translate(875, 255)">
            <rect x="-4" y="-4" width="8" height="8" fill="#6667AB" stroke="#8E8FC9" stroke-width="1.2" />
            <text x="8" y="3" fill="#8E8FC9" font-family="monospace" font-size="8">GUAM (ANDERSEN)</text>
          </g>

          <!-- Diego Garcia -->
          <g class="map-node" data-id="diegogarcia" transform="translate(650, 315)">
            <rect x="-4" y="-4" width="8" height="8" fill="#6667AB" stroke="#8E8FC9" stroke-width="1.2" />
            <text x="8" y="3" fill="#8E8FC9" font-family="monospace" font-size="8">DIEGO GARCIA</text>
          </g>

          <!-- Djibouti Multi-Base -->
          <g class="map-node" data-id="djibouti" transform="translate(560, 255)">
            <rect x="-4" y="-4" width="8" height="8" fill="#6667AB" stroke="#8E8FC9" stroke-width="1.2" />
            <text x="8" y="3" fill="#8E8FC9" font-family="monospace" font-size="8">DJIBOUTI HUBS</text>
          </g>

          <!-- Okinawa / Kadena -->
          <g class="map-node" data-id="okinawa" transform="translate(835, 195)">
            <rect x="-4" y="-4" width="8" height="8" fill="#6667AB" stroke="#8E8FC9" stroke-width="1.2" />
            <text x="8" y="3" fill="#8E8FC9" font-family="monospace" font-size="8">OKINAWA (KADENA)</text>
          </g>

          <!-- Tartus Naval Facility -->
          <g class="map-node" data-id="tartus" transform="translate(555, 165)">
            <rect x="-4" y="-4" width="8" height="8" fill="#6667AB" stroke="#8E8FC9" stroke-width="1.2" />
            <text x="8" y="3" fill="#8E8FC9" font-family="monospace" font-size="8">TARTUS NAVAL</text>
          </g>

          <!-- Sevastopol -->
          <g class="map-node" data-id="sevastopol" transform="translate(550, 120)">
            <rect x="-4" y="-4" width="8" height="8" fill="#6667AB" stroke="#8E8FC9" stroke-width="1.2" />
            <text x="8" y="3" fill="#8E8FC9" font-family="monospace" font-size="8">SEVASTOPOL</text>
          </g>
        </g>
      </svg>
    </div>

    <!-- Live Node Intel Drawer -->
    <div class="intel-drawer hud-panel" id="intelDrawer">
      <div class="drawer-header font-mono">
        <span class="badge badge-pantone-2021" id="drawerBadge">TACTICAL DOSSIER</span>
        <span class="text-dim" style="font-size: 0.72rem;">CLICK ANY PIN TO INSPECT</span>
      </div>
      
      <div class="drawer-body" id="drawerBody">
        <h4 class="drawer-title" id="nodeTitle">Strait of Hormuz</h4>
        <p class="drawer-meta font-mono" id="nodeMeta">21.0M bpd (21% of global petroleum liquids) • Chokepoint Category 1</p>

        <div class="drawer-stats-grid">
          <div class="stat-box">
            <span class="stat-label font-mono">PRIMARY THREAT</span>
            <span class="stat-val" id="nodeThreat" style="color: #BB2649;">ASBM / Drone Swarms / Naval Mines</span>
          </div>
          <div class="stat-box">
            <span class="stat-label font-mono">DAILY CARGO VALUE</span>
            <span class="stat-val" id="nodeValue" style="color: #F5DF4D;">$1.85 Billion / Day</span>
          </div>
          <div class="stat-box">
            <span class="stat-label font-mono">DEFCON SENSITIVITY</span>
            <span class="stat-val font-mono" id="nodeDefcon" style="color: #FFBE98;">CRITICAL (LEVEL 2)</span>
          </div>
          <div class="stat-box">
            <span class="stat-label font-mono">BYPASS CAPACITY</span>
            <span class="stat-val font-mono" id="nodeBypass">Petroline (5.0M bpd) only</span>
          </div>
        </div>

        <div class="creator-hook-box">
          <div class="hook-label font-mono">CREATOR VIDEO HOOK / SCRIPT ANGLE:</div>
          <p class="hook-text" id="nodeHook">
            "If Hormuz shuts down for 14 days, Brent crude breaks $140/bbl within 72 hours. In this video, we break down the exact Iranian anti-access/area-denial (A2/AD) missile kill chain and why US Fifth Fleet minesweepers are the unsung heroes of global commerce."
          </p>
        </div>

        <div class="drawer-actions">
          <button class="btn-tactical btn-outline font-mono" id="copyHookBtn" style="font-size: 0.75rem;">📋 Copy Creator Hook</button>
          <a href="/creator-studio" class="btn-tactical btn-primary font-mono" style="font-size: 0.75rem;">Insert into Teleprompter →</a>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  const intelData = {
    hormuz: {
      title: "Strait of Hormuz",
      badge: "MARITIME CHOKEPOINT",
      meta: "21.0M bpd (21% of global petroleum liquids) • Persian Gulf Exit",
      threat: "ASBMs, IRGCN Fast Swarm, Sub-surface Mines, Coastal Silkworm ASCMs",
      val: "$1.85B / Day",
      defcon: "CRITICAL (DEFCON 2)",
      bypass: "East-West Pipeline (5.0M bpd max)",
      hook: "If Hormuz shuts down for 14 days, Brent crude breaks $140/bbl within 72 hours. In this video, we break down the exact Iranian A2/AD missile kill chain and why US Fifth Fleet minesweepers are the unsung heroes of global commerce."
    },
    mandeb: {
      title: "Bab el-Mandeb & Red Sea",
      badge: "MARITIME CHOKEPOINT",
      meta: "8.8M bpd + 12% global maritime containerized trade",
      threat: "Ansar Allah (Houthi) Anti-Ship Ballistic Missiles, USV Drones, Sea Mines",
      val: "$1.12B / Day",
      defcon: "ACTIVE COMBAT (DEFCON 2)",
      bypass: "Cape of Good Hope (+14 days, +$1.2M fuel)",
      hook: "For the first time in naval warfare history, anti-ship ballistic missiles (ASBMs) were fired in combat against commercial merchant shipping in Bab el-Mandeb. Here is how Operation Prosperity Guardian changed modern naval surface doctrine forever."
