    arctic: {
      title: "Arctic Bastion / Kola Peninsula",
      badge: "KINETIC FLASHPOINT",
      meta: "Russian Northern Fleet HQ • Murmansk • 2/3 of Russia's sea-based nuclear deterrent",
      threat: "Borei-A SSBNs with Bulava SLBMs, Yasen-M SSGNs, Bastion-P coastal defense",
      val: "Northern Sea Route: $0→$20B projected by 2030",
      defcon: "STRATEGIC WATCH (DEFCON 3)",
      bypass: "None — only viable Arctic submarine egress",
      hook: "Russia's Kola Peninsula hosts two-thirds of its sea-based nuclear deterrent. The Borei-A submarines carrying 96 Bulava warheads patrol under Arctic ice where they are virtually undetectable—and NATO's only counter is the P-8 Poseidon."
    },
    persian_gulf: {
      title: "Persian Gulf / Kharg Island",
      badge: "KINETIC FLASHPOINT",
      meta: "Iran's primary oil export terminal • 90% of Iranian crude exports",
      threat: "IRGCN fast-attack swarms, Khalij Fars ASBMs, minelaying, Fateh-class submarines",
      val: "Iranian crude: 1.5M bpd export, $130M/day revenue",
