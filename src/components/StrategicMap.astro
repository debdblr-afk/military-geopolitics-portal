      threat: "Submarine interdiction, minefields, maritime blockade choke",
      val: "$3.4B / Day",
      defcon: "HIGH STRATEGIC (DEFCON 3)",
      bypass: "Sunda or Lombok Straits (+3 to 5 days navigation)",
      hook: "China's greatest strategic vulnerability isn't its economy or demographics—it's this 1.5-nautical-mile wide waterway known as the 'Malacca Dilemma'. If the US Navy blockades this corridor, China loses 80% of its seaborne oil in 45 days."
    },
    taiwan: {
      title: "Taiwan Strait & First Island Chain",
      badge: "THEATER CHOKEPOINT",
      meta: "100nm wide • 48% of global container ship fleet transits annually",
      threat: "PLAN amphibious assault fleet, A2/AD DF-21D/DF-26 'Carrier Killers', Mine warfare",
      val: "$2.7B / Day (plus 90% leading-edge TSMC semiconductors)",
      defcon: "SEVERE (DEFCON 2)",
