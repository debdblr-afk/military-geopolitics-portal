  document.querySelectorAll('.map-node').forEach(node => {
    node.addEventListener('click', () => {
      const id = node.getAttribute('data-id');
      const data = intelData[id] || intelData['hormuz'];
      
      document.getElementById('nodeTitle').innerText = data.title;
      document.getElementById('drawerBadge').innerText = data.badge;
      document.getElementById('nodeMeta').innerText = data.meta;
      document.getElementById('nodeThreat').innerText = data.threat;
      document.getElementById('nodeValue').innerText = data.val;
      document.getElementById('nodeDefcon').innerText = data.defcon;
      document.getElementById('nodeBypass').innerText = data.bypass;
      document.getElementById('nodeHook').innerText = `"${data.hook}"`;

      // Highlight clicked node
      document.querySelectorAll('.map-node').forEach(n => n.classList.remove('active-node'));
      node.classList.add('active-node');
    });
  });

  // Layer Visibility Toggle
  document.querySelectorAll('.layer-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      btn.classList.toggle('active');
      const layerId = 'layer-' + btn.getAttribute('data-layer');
      const group = document.getElementById(layerId);
      if (group) {
        group.style.display = btn.classList.contains('active') ? '' : 'none';
      }
    });
  });

  // Copy Hook Button
  const copyBtn = document.getElementById('copyHookBtn');
  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      const hookText = document.getElementById('nodeHook').innerText;
      navigator.clipboard.writeText(hookText);
      copyBtn.innerText = '✓ Copied to Clipboard!';
      setTimeout(() => copyBtn.innerText = '📋 Copy Creator Hook', 2000);
