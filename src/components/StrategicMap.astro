    },
    scs: {
      title: "South China Sea Bastion",
      badge: "KINETIC FLASHPOINT",
      meta: "Fiery Cross, Subi, Mischief Reef militarized artificial islands • 9-Dash Line",
      threat: "PLAN Carrier Strike Groups, Type 055 cruisers, YJ-21 hypersonic ASCMs",
      val: "$3.37 Trillion Annual Trade",
      defcon: "ELEVATED (DEFCON 2)",
      bypass: "detour south through Indonesian archipelagic sea lanes",
      hook: "China didn't just build islands in the South China Sea—they constructed unsinkable aircraft carriers armed with HQ-9B SAMs and YJ-12 supersonic anti-ship missiles. Here is what happens if a US Carrier Strike Group attempts freedom of navigation."
    },
    blacksea: {
      title: "Black Sea Theater & Crimea",
      badge: "KINETIC FLASHPOINT",
      meta: "Sevastopol, Snake Island, Kerch Strait Bridge, Novorossiysk",
      threat: "Magura V5 & Sea Baby USV maritime drone swarms, Kalibr launch platforms",
      val: "Global grain export corridor & Russian Black Sea Fleet base",
